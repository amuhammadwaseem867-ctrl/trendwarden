# Only needed for LIVE trading. Create API keys with TRADE permission only.
# NEVER enable withdrawal permission. Restrict keys to your IP if the exchange allows it.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (OKX, KuCoin, Coinbase) also need a passphrase:
EXCHANGE_API_PASSWORD=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MetaTrader 5 (XM). Optional: if left empty the bot uses whatever account
# is already logged in to the open MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe, only if the bot cannot find MetaTrader 5 itself:
MT5_PATH=

# --- Trader skill pack features ---
# SEC asks every tool to identify itself (smart money + stock copy-trading):
SEC_USER_AGENT=Your Name you@example.com
# Stock copy-trading through Alpaca (alpaca.markets). Start with PAPER keys.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
